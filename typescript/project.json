{
  "name": "typescript-tooling",
  "targets": {
    "check": {
      "command": "corepack pnpm check",
      "options": {
        "cwd": "typescript"
      },
      "cache": false
    },
    "test": {
      "command": "corepack pnpm test:run",
      "options": {
        "cwd": "typescript"
      },
      "cache": false
    },
    "test-native": {
      "command": "corepack pnpm test:native",
      "options": {
        "cwd": "typescript"
      },
      "cache": false
    },
    "test-e2e": {
      "command": "corepack pnpm test:e2e",
      "options": {
        "cwd": "typescript"
      },
      "cache": false
    },
    "test-stress": {
      "command": "corepack pnpm test:stress:native",
      "options": {
        "cwd": "typescript"
      },
      "cache": false
    }
  }
}
